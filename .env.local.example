DJANGO_SETTINGS_MODULE=pushdemo.settings.local
RUN_MODE=local
DJANGO_SECRET_KEY=local-only-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

POSTGRES_DB=pushdemo
POSTGRES_USER=pushdemo
POSTGRES_PASSWORD=pushdemo-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

VAPID_SUBJECT=mailto:admin@example.com
VAPID_PRIVATE_KEY_PATH=/app/keys/vapid_private.pem
VAPID_PUBLIC_KEY_PATH=/app/keys/vapid_public.txt

DEMO_USERNAME=demo
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=Demo12345!
RESET_DEMO_PASSWORD=0
